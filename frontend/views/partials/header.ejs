    <header class="header">
      <div class="header-left">
        <button id="mobile-menu-btn" class="mobile-menu-btn">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
        </button>
        <a href="/" class="brand-logo">
          <img src="/assets/channels4_profile.jpg" alt="Angel One Logo" width="26" height="26">
        </a>
        <div class="market-ticker">
          <div class="ticker-item">
            <div class="ticker-title">
              <div class="ticker-name">NIFTY</div>
            </div>
            <div class="ticker-value">
              <div class="ticker-val val-down" id="nifty-price">24,398.45</div>
              <span class="ticker-arrow arrow val-down" id="nifty-arrow">▼</span>
              <div class="ticker-change val-down" id="nifty-change">-37.50 (-0.15%)</div>
            </div>
          </div>
          <div class="ticker-item" style="border-left: 1px solid #E2E8F0; padding-left: 12px;">
            <div class="ticker-title">
              <div class="ticker-name">SENSEX</div>
            </div>
            <div class="ticker-value">
              <div class="ticker-val val-up" id="sensex-price">77,982.79</div>
              <span class="ticker-arrow arrow val-up" id="sensex-arrow">▲</span>
              <div class="ticker-change val-up" id="sensex-change">+16.44 (+0.02%)</div>
            </div>
          </div>
          <button class="ticker-dropdown-btn">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </button>
        
      </div>
      </div>
<div class="nav-right">
      <div class="header-center">
        <div class="global-search-box">
          <span class="search-icon">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
          </span>
          <input id="global-search-input" type="text" class="global-search-input" placeholder="Search for Anything">
          <span class="search-shortcut">[Ctrl + S]</span>
        </div>
      </div>

      <div class="header-right">
        <ul class="nav-links">  
          <li><a href="/" class="nav-link <%= activePage === 'home' ? 'active' : '' %>"><img src="/assets/home fill.png" alt=""></a></li>
          <li><a class="nav-link <%= activePage === 'markets' ? 'active' : '' %>">Markets</a></li>
          <li><a 
             class="nav-link <%= activePage === 'tradeone' ? 'active' : '' %>">TradeOne</a></li>
          <li><a href="/portfolio" class="nav-link <%= activePage === 'portfolio' ? 'active' : '' %>">Portfolio</a></li>
          <li><a href="/orders" class="nav-link <%= activePage === 'orders' ? 'active' : '' %>">Orders</a></li>
          <li><a href="/positions" class="nav-link <%= activePage === 'positions' ? 'active' : '' %>">Positions</a></li>
          <li><a href="/tools" class="nav-link <%= activePage === 'tools' ? 'active' : '' %>">Tools ▾</a></li>
        </ul>
        <button class="icon-btn" title="Notifications">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
          <span class="notification-badge"></span>
        </button>
        <a href="/profile" class="profile-avatar" title="My Account" id="headerProfileAvatar">BW</a>
      </div>
</div>

    </header>
