<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: 'Angel One - Markets & Stock Discovery', extraCss: ["/css/markets.css"] }) %>
</head>
<body>
  <div class="app-container">
   <!-- Sticky Top Header -->
    <%- include('partials/header', { activePage: 'markets' }) %>


    <!-- Main Layout Content -->
    <div class="main-layout">
      <!-- Left Watchlist Sidebar -->
      <%- include('partials/watchlist') %>

      <!-- Main Content Area -->
      <main class="content-area">
        <!-- Sub Tabs Bar -->
        <div class="sub-tabs-container">
          <div class="sub-tabs">
            <a class="sub-tab-item active">Stock Discovery</a>
            <a class="sub-tab-item">Index F&O</a>
            <a class="sub-tab-item">Stocks F&O</a>
            <a class="sub-tab-item">Commodities</a>
            <a class="sub-tab-item">All Indices</a>
            <a class="sub-tab-item">News</a>
          </div>
          <button id="toggle-watchlist-btn" class="toggle-watchlist-btn">👁 HIDE WATCHLIST</button>
        </div>

        <!-- Index Overview Card -->
        <div class="index-overview-card">
          <h2 class="card-title" style="font-size: 15px; margin-bottom: 16px;">Index Overview</h2>

          <!-- Horizontal Index Selector Tabs -->
          <div id="index-tabs-bar" class="index-tabs-bar">
            <!-- Dynamically generated by markets.js -->
          </div>

          <!-- Index Details: High/Low Left vs Chart Right -->
          <div class="index-detail-body">
            <!-- Left Side: Day's High / Low Stats -->
            <div class="days-range-container">
              <span class="section-subtitle">Day's High/Low</span>

              <div class="range-slider-wrapper">
                <div id="range-pointer" class="range-pointer" style="left: 65%;"></div>
                <div class="range-bar"></div>
              </div>

              <div class="range-labels-row">
                <div>
                  <div id="stat-low" class="range-val">24311.40</div>
                  <div class="range-lbl">Low</div>
                </div>
                <div style="text-align: right;">
                  <div id="stat-high" class="range-val">24431.60</div>
                  <div class="range-lbl">High</div>
                </div>
              </div>

              <div class="hl-stats-grid">
                <div class="hl-stat-item">
                  <span class="hl-stat-lbl">Open</span>
                  <span id="stat-open" class="hl-stat-val">24,431.60</span>
                </div>
                <div class="hl-stat-item">
                  <span class="hl-stat-lbl">High</span>
                  <span id="stat-high-sub" class="hl-stat-val val-up">24,431.60</span>
                </div>
                <div class="hl-stat-item">
                  <span class="hl-stat-lbl">Low</span>
                  <span id="stat-low-sub" class="hl-stat-val val-down">24,311.40</span>
                </div>
                <div class="hl-stat-item">
                  <span class="hl-stat-lbl">Close</span>
                  <span id="stat-close" class="hl-stat-val">24,435.95</span>
                </div>
              </div>
            </div>

            <!-- Right Side: Canvas Stock Price Area Chart -->
            <div class="chart-container">
              <div class="chart-canvas-wrapper">
                <canvas id="market-chart-canvas"></canvas>
              </div>

              <div class="chart-controls-bar">
                <div class="timeframe-group">
                  <button class="tf-btn active">1D -0.17%</button>
                  <button class="tf-btn">1W -0.98%</button>
                  <button class="tf-btn">1M +1.42%</button>
                  <button class="tf-btn">1Y -0.91%</button>
                  <button class="tf-btn">All</button>
                </div>
                <button class="chart-setting-btn" title="Candlestick settings">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="9" y1="18" x2="9" y2="10"></line><line x1="15" y1="14" x2="15" y2="6"></line><line x1="12" y1="2" x2="12" y2="22"></line></svg>
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- Most Bought Stocks Section -->
        <div>
          <div class="card-header" style="margin-bottom: 12px;">
            <h2 class="card-title" style="font-size: 15px;">Most Bought Stocks</h2>
            <a class="card-link">VIEW ALL &gt;</a>
          </div>

          <div id="most-bought-grid" class="most-bought-grid">
            <!-- Dynamically populated by markets.js -->
          </div>
        </div>

      </main>
    </div>

    <!-- Floating Ask Angel Button -->
    <%- include('partials/ask-angel-btn') %>
  </div>

  <%- include('partials/scripts', { extraJs: ["/js/watchlist.js","/js/charts.js","/js/markets.js"] }) %>
</body>
</html>
