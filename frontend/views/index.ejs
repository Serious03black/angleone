                        <span class="ipo-type-badge">MAINBOARD</span>
                      </div>
                    </div>
                    
                  </div>

                  <div class="ipo-details-grid">
                    <div class="ipo-detail-item">
                      <span class="ipo-label">Closes On</span>
                      <span class="ipo-value">14 Aug 26</span>
                    </div>
                    <div class="ipo-detail-item right">
                      <span class="ipo-label">Min. Investment</span>
                      <span class="ipo-value">₹14,168</span>
                    </div>
                  </div>
                </div>

                <div class="ipo-footer">
                  <span class="ipo-label">Overall Subscription</span>
                  <span class="ipo-sub-val">1.65x</span>
                </div>
              </div>

              <!-- IPO Card 3 -->
              <div class="ipo-card">
                <div class="ipo-up">
                  <div class="ipo-header">
                    <div class="ipo-brand">
                      <div class="ipo-logo-badge" ></div>
                      <div>
                        <div class="ipo-name">BEHARI LAL ENGINEERING LTD</div>
                        <span class="ipo-type-badge">MAINBOARD</span>
                      </div>
                    </div>
                  </div>

                  <div class="ipo-details-grid">
                    <div class="ipo-detail-item">
                      <span class="ipo-label">Closes On</span>
                      <span class="ipo-value">14 Aug 26</span>
                    </div>
                    <div class="ipo-detail-item right">
                      <span class="ipo-label">Min. Investment</span>
                      <span class="ipo-value">₹14,092</span>
                    </div>
                  </div>
                </div>

                <div class="ipo-footer">
                  <span class="ipo-label">Overall Subscription</span>
                  <span class="ipo-sub-val">3.87x</span>
                </div>
              </div>
            </div>
          </div>


    </div>






      
          <div class="b3 box">
            <section class="section fo-trade-section">
              <h2 class="section-heading card-title">Trade in Futures & Options</h2>
          <!-- Top Split: Heatmap Grid + Stock F&O List -->
          <div class="fo-top-row">
            <!-- Left: Sector Heatmap -->
            <div class="heatmap-container">
              
              <div class="heatmap-grid">
                <!-- Row 1 -->
                <div class="sector-card green active" data-sector="Consumer">
                  <span class="sector-name">Consumer</span>
                  <span class="sector-change">+0.91%</span>
                </div>
                <div class="sector-card green" data-sector="Infra">
                  <span class="sector-name">Infra</span>
                  <span class="sector-change">+0.34%</span>
                </div>
                <div class="sector-card green" data-sector="Technology">
                  <span class="sector-name">Technology</span>
                  <span class="sector-change">+0.34%</span>
                </div>
                <div class="sector-card green" data-sector="Realty">
                  <span class="sector-name">Realty</span>
                  <span class="sector-change">+0.28%</span>
                </div>
                <div class="sector-card green" data-sector="PSE">
                  <span class="sector-name">PSE</span>
                  <span class="sector-change">+0.18%</span>
                </div>
                <!-- Row 2 -->
                <div class="sector-card green" data-sector="Energy">
                  <span class="sector-name">Energy</span>
                  <span class="sector-change">+0.02%</span>
                </div>
                <div class="sector-card red" data-sector="Pharma">
                  <span class="sector-name">Pharma</span>
                  <span class="sector-change">-0.00%</span>
                </div>
                <div class="sector-card red" data-sector="Services">
                  <span class="sector-name">Services</span>
                  <span class="sector-change">-0.01%</span>
                </div>
                <div class="sector-card red" data-sector="Auto">
                  <span class="sector-name">Auto</span>
                  <span class="sector-change">-0.02%</span>
                </div>
                <div class="sector-card red" data-sector="Finance">
                  <span class="sector-name">Finance</span>
                  <span class="sector-change">-0.16%</span>
                </div>
              </div>
            </div>

            <!-- Right: Selected Sector Stock F&O Table -->
            <div class="sector-list-container">
              <div class="sector-list-header">
