                    <tr>
                      <th style="text-align: left;">F&O Scrips</th>
                      <th style="text-align: right;">LTP</th>
                      <th style="text-align: right;">LTP Change (%)</th>
                    </tr>
                  </thead>
                  <tbody id="sector-table-body">
                    <tr>
                      <td class="fno">
                        <span class="scrip-name">COLPAL</span>
                        <span class="scrip-date">25 Aug 2026</span>
                      </td>
                      <td class="text-right">
                        <span class="price loss">₹1,993.80 ▼</span>
                      </td>
                      <td class="text-right">
                        <span class="change loss">-12.50 (-0.62%)</span>
                      </td>
                    </tr>
                    <tr>
                      <td class="fno">
                        <span class="scrip-name">DABUR</span>
