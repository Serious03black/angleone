                      <td class="text-right">
                        <span class="change gain">+29.50 (1.43%)</span>
                      </td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>

          <!-- Bottom Split: Index F&O vs Commodities Tables -->
          <div class="fo-bottom-row">

            <!-- Left Box: Index F&O -->
            <div class="fo-column-box">
              <div class="column-header">
                <h3 class="column-title">Index F&O</h3>
                <a href="#" class="section-link card-link ">VIEW ALL INDEX F&O &gt;</a>
              </div>

              <!-- Filter Controls -->
              <div class="filter-controls">
                <select class="pill-select" id="index-select">
