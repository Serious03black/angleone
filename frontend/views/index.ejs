
<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: 'Angel One - Modern Trading & Investment Dashboard', extraCss: ["/css/dashboard.css"] }) %>
</head>
<body>
  <div class="app-container">
    <!-- Sticky Top Header -->
    <%- include('partials/header', { activePage: 'home' }) %>






    <!-- Main Layout Content -->
    <div class="main-layout">
      <!-- Full Width Home Dashboard Content -->
      <main class="content-area full-width">
        <div class="dashboard-container">
          <div class="b1">
 <!-- Banner 1: Commodity Market Live -->
  <div class="live-banner">
            <div class="live-banner-left">
              <span class="live-tag">
                <span style="font-size: 8px;"><img src="/assets/wifi.png" alt="" width="14" ></span> LIVE
              </span>
              <span class="live-text">Commodities market is open (till 11:30 PM)</span>
            </div>
            <a href="/markets" class="btn btn-primary btn-sm">VIEW COMMODITIES</a>
          </div>
          

           <!-- Banner 2: Get Ready to Invest -->
          <div class="invest-banner">
            <div class="invest-banner-left">
              <div class="coin-illustration">₹</div>
              <div class="invest-banner-info">
                <h3>Get ready to Invest</h3>
                <p>Add funds to start your trading journey with Angel One</p>
              </div>
            </div>
            <button class="btn btn-primary" onclick="showToast('✓ Redirecting to Add Funds Gateway...')">ADD FUNDS</button>
          </div>

          <div class="discovery-section">
            <h2 class="discovery-section-title">What are you looking for today?</h2>
            <div class="discovery-grid">
              <a href="/markets" class="discovery-card">
                <div class="discovery-icon-wrapper">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="20" x2="12" y2="10"></line><line x1="18" y1="20" x2="18" y2="4"></line><line x1="6" y1="20" x2="6" y2="16"></line></svg>
                </div>
                <span class="discovery-card-title">Stock Discovery</span>
              </a>

              <a href="/markets" class="discovery-card">
                <div class="discovery-icon-wrapper">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path></svg>
                </div>
                <span class="discovery-card-title">Mutual Funds</span>
              </a>

              <a href="/markets" class="discovery-card">
                <div class="discovery-icon-wrapper">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
                </div>
                <span class="discovery-card-title">Futures & Options</span>
              </a>

              <a href="/markets" class="discovery-card">
                <div class="discovery-icon-wrapper">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
                </div>
                <span class="discovery-card-title">ETF Discovery</span>
              </a>

              <a href="/markets" class="discovery-card">
                <div class="discovery-icon-wrapper">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2Zm0 0a2 2 0 0 1-2-2v-9c0-1.1.9-2 2-2h2"></path></svg>
                </div>
                <span class="discovery-card-title">News Discovery</span>
              </a>
            </div>
          </div>

</div>



    <div class="b2 box">

          <!-- IPO Section -->
          <div class="ipo-section">
            <div class="card-header" style="margin-bottom: 12px;">
