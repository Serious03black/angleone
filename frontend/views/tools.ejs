<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: 'Angel One - Trading & Investment Tools' }) %>
</head>
<body>
  <div class="app-container">
<!-- Sticky Top Header -->
    <%- include('partials/header', { activePage: 'tools' }) %>


    <!-- Main Layout Content -->
    <div class="main-layout">
      <!-- Left Watchlist Sidebar -->
      <%- include('partials/watchlist') %>

      <!-- Main Content Area -->
      <main class="content-area">
        <div class="sub-tabs-container">
          <div class="sub-tabs">
            <a class="sub-tab-item active">Trading &amp; Investment Tools</a>
          </div>
          <button id="toggle-watchlist-btn" class="toggle-watchlist-btn">👁 HIDE WATCHLIST</button>
        </div>

        <div id="tools-grid-container" class="tools-grid">
          <!-- Populated by script -->
        </div>

      </main>
    </div>

    <!-- Floating Ask Angel Button -->
    <%- include('partials/ask-angel-btn') %>
  </div>

  <%- include('partials/scripts', { extraJs: ["/js/watchlist.js"] }) %>
<script>
    document.addEventListener("DOMContentLoaded", () => {
      const container = document.getElementById("tools-grid-container");
      const tools = window.AngelOneData ? window.AngelOneData.tools : [];
      if (container) {
        container.innerHTML = tools.map(t => `
          <div class="tool-card" onclick="showToast('✓ Opening ${t.title}...')">
            <div class="tool-icon-circle">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="2" width="16" height="20" rx="2" ry="2"></rect><line x1="8" y1="6" x2="16" y2="6"></line><line x1="16" y1="14" x2="16" y2="18"></line><path d="M16 10h.01"></path><path d="M12 10h.01"></path><path d="M8 10h.01"></path><path d="M12 14h.01"></path><path d="M8 14h.01"></path><path d="M12 18h.01"></path><path d="M8 18h.01"></path></svg>
            </div>
            <div>
              <div class="tool-title">${t.title}</div>
              <div class="tool-desc">${t.desc}</div>
            </div>
          </div>
        `).join("");
      }
    });
  </script>
</body>
</html>
